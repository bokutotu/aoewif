cabal-version: 3.0
name: aoewif
version: 0.1.0
synopsis: Tensor IR scheduling and C/CUDA source generation
description:
  A base-only tensor compute IR with CPU and CUDA scheduling,
  validation, and deterministic C and CUDA source generation.

license: NONE
category: Compilers
build-type: Simple

source-repository head
  type: git
  location: https://github.com/bokutotu/aoewif.git

library
  hs-source-dirs: src
  exposed-modules:
    Aoewif
    Aoewif.Codegen
    Aoewif.IR
    Aoewif.Schedule

  build-depends:
    base >=4.22 && <4.23

  default-language: GHC2024
  ghc-options: -Wall

test-suite aoewif-test
  type: exitcode-stdio-1.0
  hs-source-dirs: tests
  main-is: Spec.hs
  other-modules:
    CodegenSpec
    IRSpec
    ScheduleSpec

  build-depends:
    aoewif,
    base >=4.22 && <4.23,
    hspec,

  default-language: GHC2024
  ghc-options: -Wall
